# Copy to server/.env and fill in values. Never commit .env.

DATABASE_URL=postgresql://splitease:password@localhost:5433/splitease_dev

# Minimum 32 characters each (required by env validation)
JWT_SECRET=replace_with_a_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_a_different_secret_32_chars_min

# Optional — Plaid Link + Transfer (Sandbox recommended).
# Get Sandbox keys from https://dashboard.plaid.com/ → Team settings → Keys (Sandbox secret).
# See root README → “Testing Plaid Sandbox (optional)”.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production — drives Plaid API base URL
PLAID_ENV=sandbox
# Comma-separated Link products; include transfer for Plaid Transfer flows
PLAID_PRODUCTS=auth,transactions,transfer
PLAID_COUNTRY_CODES=US
# Optional; OAuth redirect if you configure it in Plaid Dashboard
PLAID_REDIRECT_URI=
# Optional; leave empty for local dev unless you configure webhooks.
PLAID_WEBHOOK_URL=
# When true and credentials present, allows Transfer authorization/create (Sandbox-first).
ENABLE_PLAID_TRANSFER_SANDBOX=false
# Must be true only with compliance + production Transfer approval. Never enable casually.
ENABLE_REAL_MONEY_MOVEMENT=false

ENCRYPTION_KEY=replace_with_random_32_byte_key_or_long_secret

PORT=4000
CLIENT_ORIGIN=http://localhost:3000

AWS_BUCKET_NAME=splitease-backups
